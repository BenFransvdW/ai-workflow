# Copy to .env and fill in. Never commit .env.

# Reddit (script-type app: https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=shorts-pipeline/0.1 by u/your_username

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# TTS providers (only the ones your voices use)
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Pexels (https://www.pexels.com/api/)
PEXELS_API_KEY=

# Telegram approval bot (token from @BotFather; chat id: see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube Data API OAuth client (Desktop app) and the token file written by `shorts auth-youtube`
YOUTUBE_CLIENT_SECRETS=/home/pi/shorts/secrets/client_secret.json
YOUTUBE_TOKEN_FILE=/home/pi/shorts/secrets/youtube_token.json
